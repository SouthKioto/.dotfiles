//  kioto@batlomiej — arch + hyprland // 枯山水 karesansui (ogród zen)
// Logo = kwadratowy kadr aktualnej tapety (~/.cache/fastfetch/logo.png,
// robi go hypr/scripts/cache-wallpaper.sh). Kolory to paleta ANSI kitty,
// więc idą za matugenem: 2 = akcent, 3 = mech, 4 = piasek, 8 = kamień.
// Wymaga Nerd Font + fontu z japońskimi znakami (Noto Sans CJK JP).
{
  "logo": {
    "type": "kitty-direct",
    "source": "~/.cache/fastfetch/logo.png",
    "width": 34,
    "height": 16,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "33",
      "title": "32",
      "output": "37"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#1;32}{user-name}{#0;90} 〆 {#1;33}{host-name}"
    },
    {
      "type": "custom",
      "format": "{#90}─────────────── {#34}枯山水{#90} ──"
    },
    /////===== 庭 niwa — ogród (system) =====/////
    {
      "type": "custom",
      "format": "{#32}庭 {#90}niwa"
    },
    {
      "type": "os",
      "key": "{#34}道{#90} os    ",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "{#34}核{#90} kernel"
    },
    {
      "type": "wm",
      "key": "{#34}窓{#90} wm    "
    },
    {
      "type": "packages",
      "key": "{#34}包{#90} pkgs  ",
      "combined": true
    },
    {
      "type": "shell",
      "key": "{#34}殻{#90} shell "
    },
    {
      "type": "terminal",
      "key": "{#34}端{#90} term  "
    },
    "break",
    /////===== 石 ishi — kamienie (sprzęt) =====/////
    {
      "type": "custom",
      "format": "{#32}石 {#90}ishi"
    },
    {
      "type": "cpu",
      "key": "{#33}脳{#90} cpu   ",
      "format": "{name} ({cores-logical})"
    },
    {
      "type": "gpu",
      "key": "{#33}絵{#90} gpu   ",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "{#33}憶{#90} ram   "
    },
    {
      "type": "disk",
      "key": "{#33}蔵{#90} disk  ",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "{#33}電{#90} bat   "
    },
    {
      "type": "uptime",
      "key": "{#33}時{#90} up    "
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 0
    },
    {
      "type": "custom",
      "format": "{#3;90}静寂の庭 — cisza, kamień, piasek"
    }
  ]
}
