# =====================================================================
#  Dotfiles ~/.config — tryb WHITELIST
#  Domyślnie ignorujemy WSZYSTKO, a potem jawnie odblokowujemy tylko
#  to, co chcemy wersjonować. Nowa aplikacja (przeglądarka, komunikator,
#  menedżer haseł...) nigdy nie trafi do repo przypadkiem.
#
#  Dodanie nowego configu:
#    !nazwa/        <- odblokuj katalog
#    !nazwa/**      <- i jego zawartość
# =====================================================================

/*

# --- meta repo -------------------------------------------------------
!/.gitignore
!/.gitmodules
!/README.md

# --- submoduły (osobne repo) -----------------------------------------
!/fish
!/ghostty
!/nvim

# --- pliki w katalogu głównym ----------------------------------------
!/starship.toml
!/gruvbox-rainbow.toml
!/mimeapps.list
!/brave-flags.conf
!/electron-flags.conf
!/vesktop-flags.conf

# --- katalogi z konfiguracją -----------------------------------------
!/btop/
!/cava/
!/fastfetch/
!/fontconfig/
!/gtk-3.0/
!/gtk-4.0/
!/hypr/
!/kitty/
!/matugen/
!/qt5ct/
!/qt6ct/
!/rofi/
!/starship/
!/superfile/
!/swaync/
!/systemd/
!/waybar/
!/waypaper/
!/wlogout/
!/xdg-desktop-portal/
!/zellij/
!/atuin/
!/lazygit/
!/quickshell/
!/rice/
# dodatki 2026-10-28: adnotacje zrzutów, PDF (zathurarc z matugena), wideo, zdjęcia
!/satty/
!/zathura/
!/mpv/
!/imv/
# spotify-player: tylko motyw (app.toml ma client_id)
!/spotify-player/
/spotify-player/*
!/spotify-player/theme.toml
!/swayosd/
!/yazi/
# vesktop: tylko motyw (reszta katalogu to sesja/cache Discorda)
!/vesktop/
/vesktop/*
!/vesktop/themes/

# =====================================================================
#  Wyjątki wewnątrz odblokowanych katalogów
# =====================================================================

# Raporty / dane specyficzne dla maszyny
/hypr/raport.html
/rofi/.current_wallpaper
/btop/btop.log
/rice/sddm/rice/dynamic/

# Kopie zapasowe i pliki tymczasowe edytorów
*.bak
*.save
*.old
*.orig
*.swp
*.swo
*~
.#*
\#*#

# =====================================================================
#  Siatka bezpieczeństwa — sekrety. Działa nawet gdy ktoś (Ty za rok)
#  odblokuje cały katalog. Sprawdź `git check-ignore -v <plik>`.
# =====================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.kdbx
*.gpg
*.asc
id_rsa*
id_ed25519*
id_ecdsa*
*secret*
*secrets*
*credential*
*credentials*
*token*
*.token
hosts.yml
auth.json
.netrc
*.cookie
cookies*
*.sqlite
*.sqlite-*
*.db
*.db-*
*.vscdb*

# Śmieci systemowe
.DS_Store
Thumbs.db
*.log
*.pid
*.sock
__pycache__/
*.pyc
