#!/usr/bin/env bash
# Wywoływany przez /etc/pacman.d/hooks/00-timeshift-snapshot.hook (jako root).
# Nigdy nie blokuje pacmana: błąd snapshotu = tylko ostrzeżenie.

KEEP=5
STAMP=/var/lib/pacman-snapshot.last

if [[ -f $STAMP ]] && (( $(date +%s) - $(stat -c %Y "$STAMP") < 3600 )); then
    echo "  pominięto: ostatni snapshot był mniej niż godzinę temu"
    exit 0
fi

# komenda, która odpaliła pacmana (np. "pacman -Syu"), jako opis snapshotu
cmd=$(tr '\0' ' ' </proc/$PPID/cmdline 2>/dev/null | sed 's/ *$//')
if ! timeshift --create --scripted --tags O --comments "pacman: ${cmd:0:90}" >/dev/null; then
    echo "  ! Timeshift nie zrobił snapshotu — kontynuuję bez niego" >&2
    exit 0
fi
touch "$STAMP"
echo "  ✓ snapshot gotowy (przywracanie: sudo timeshift --restore)"

# rotacja: tylko snapshoty z hooka, najstarsze idą pierwsze
mapfile -t old < <(timeshift --list --scripted 2>/dev/null \
    | grep 'pacman:' | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}' | head -n -$KEEP)
for snap in "${old[@]}"; do
    timeshift --delete --snapshot "$snap" --scripted >/dev/null
done
exit 0
