/**
 * Wallpaper picker — baza z theme.rasi, siatka miniatur
 **/

@import "theme.rasi"

configuration {
    show-icons: true;
}

window {
    width: 880px;
}

entry {
    placeholder: "szukaj tapety…";
}

listview {
    columns:       4;
    lines:         2;
    fixed-columns: true;
    fixed-height:  true;
    spacing:       6px;
}

element {
    orientation:      vertical;
    padding:          6px;
    spacing:          4px;
    border:           0px 0px 1px 0px;
    border-color:     @edge-soft;
    border-radius:    3px;
    background-color: @background-alt;
}

element-icon {
    size:             120px;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
}
