/**
 * App launcher (drun) — baza z theme.rasi
 **/

@import "theme.rasi"

configuration {
    modi:                "drun";
    show-icons:          true;
    display-drun:        "";
    drun-display-format: "{name}";
}

window {
    width: 460px;
}

entry {
    placeholder: "szukaj aplikacji…";
}

listview {
    lines:        8;
    fixed-height: true;
}

element-icon {
    size: 24px;
}
