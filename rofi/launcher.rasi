/**
 * App launcher (drun), kolory z Matugena
 **/

@import "colors/colors.rasi"

configuration {
    modi:                 "drun";
    show-icons:           true;
    icon-theme:           "Papirus-Dark";
    display-drun:         "";
    drun-display-format:  "{name}";
}

* {
    font:             "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color:       @foreground;
}

window {
    location:         center;
    anchor:           center;
    width:            560px;
    border:           2px solid;
    border-color:     @selected;
    border-radius:    12px;
    background-color: @background;
}

mainbox {
    children:         [ inputbar, listview ];
    spacing:          12px;
    padding:          16px;
}

inputbar {
    children:         [ prompt, entry ];
    spacing:          10px;
    padding:          10px 14px;
    border-radius:    8px;
    background-color: @background-alt;
}

prompt {
    text-color:       @selected;
}

entry {
    placeholder:       "Szukaj aplikacji...";
    placeholder-color: @foreground;
}

listview {
    columns:          1;
    lines:            8;
    fixed-height:     true;
    cycle:            true;
    scrollbar:        false;
    spacing:          6px;
}

element {
    orientation:      horizontal;
    spacing:          12px;
    padding:          8px 12px;
    border-radius:    8px;
}

element normal.urgent {
    text-color:       @urgent;
}

element normal.active {
    text-color:       @active;
}

element selected.normal {
    background-color: @selected;
    text-color:       @background;
}

element-icon {
    size:             32px;
    vertical-align:   0.5;
}

element-text {
    vertical-align:   0.5;
    text-color:       inherit;
}
