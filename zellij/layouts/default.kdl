layout {
    default_tab_template {
        pane size=2 borderless=true {
            plugin location="file:/home/kioto/.config/zellij/plugins/zjstatus.wasm" {
                format_left   "{mode} {tabs}"
                format_center ""
                format_right  "{pipe_zjstatus_hints}{command_git} {session} │ {datetime} "
                format_space  "#[bg=#1a1110]"
                format_hide_on_overlength "true"
                format_precedence "lrc"

                border_enabled  "true"
                border_position "bottom"
                border_char     "─"
                border_format   "#[fg=#534341]{char}"

                hide_frame_for_single_pane "false"

                mode_normal "#[fg=#ffb4aa,bg=#1a1110]#[fg=#1a1110,bg=#ffb4aa,bold] NORMAL #[fg=#ffb4aa,bg=#1a1110]"
                mode_locked "#[fg=#ffb4ab,bg=#1a1110]#[fg=#1a1110,bg=#ffb4ab,bold] LOCKED #[fg=#ffb4ab,bg=#1a1110]"
                mode_resize "#[fg=#e7bdb7,bg=#1a1110]#[fg=#1a1110,bg=#e7bdb7,bold] RESIZE #[fg=#e7bdb7,bg=#1a1110]"
                mode_pane "#[fg=#ffb4aa,bg=#1a1110]#[fg=#1a1110,bg=#ffb4aa,bold] PANE #[fg=#ffb4aa,bg=#1a1110]"
                mode_tab "#[fg=#e0c38c,bg=#1a1110]#[fg=#1a1110,bg=#e0c38c,bold] TAB #[fg=#e0c38c,bg=#1a1110]"
                mode_move "#[fg=#e7bdb7,bg=#1a1110]#[fg=#1a1110,bg=#e7bdb7,bold] MOVE #[fg=#e7bdb7,bg=#1a1110]"
                mode_scroll "#[fg=#e0c38c,bg=#1a1110]#[fg=#1a1110,bg=#e0c38c,bold] SCROLL #[fg=#e0c38c,bg=#1a1110]"
                mode_search "#[fg=#e0c38c,bg=#1a1110]#[fg=#1a1110,bg=#e0c38c,bold] SEARCH #[fg=#e0c38c,bg=#1a1110]"
                mode_entersearch "#[fg=#e0c38c,bg=#1a1110]#[fg=#1a1110,bg=#e0c38c,bold] SEARCH #[fg=#e0c38c,bg=#1a1110]"
                mode_renametab "#[fg=#e0c38c,bg=#1a1110]#[fg=#1a1110,bg=#e0c38c,bold] RENAME #[fg=#e0c38c,bg=#1a1110]"
                mode_renamepane "#[fg=#e0c38c,bg=#1a1110]#[fg=#1a1110,bg=#e0c38c,bold] RENAME #[fg=#e0c38c,bg=#1a1110]"
                mode_session "#[fg=#e0c38c,bg=#1a1110]#[fg=#1a1110,bg=#e0c38c,bold] SESSION #[fg=#e0c38c,bg=#1a1110]"
                mode_tmux "#[fg=#ffb4ab,bg=#1a1110]#[fg=#1a1110,bg=#ffb4ab,bold] TMUX #[fg=#ffb4ab,bg=#1a1110]"
                mode_default_to_mode "normal"

                session "#[fg=#f1dedc,bg=#1a1110,bold]󱂬 {name}"

                tab_separator " "
                tab_normal   "#[fg=#a08c8a,bg=#1a1110] {index}:{name}{floating_indicator}{fullscreen_indicator}{sync_indicator} "
                tab_active   "#[fg=#ffb4aa,bg=#1a1110]#[fg=#1a1110,bg=#ffb4aa,bold] {index}:{name}{floating_indicator}{fullscreen_indicator}{sync_indicator} #[fg=#ffb4aa,bg=#1a1110]"
                tab_fullscreen_indicator " 󰊓"
                tab_floating_indicator   " 󰉈"
                tab_sync_indicator       " 󰓦"
                tab_display_count        "9"
                tab_truncate_start_format "#[fg=#a08c8a] < +{count} ..."
                tab_truncate_end_format   "#[fg=#a08c8a] ... +{count} >"

                // gałąź git katalogu sesji (patrz scripts/git-status.sh)
                command_git_command    "/home/kioto/.config/zellij/scripts/git-status.sh"
                command_git_format     "#[fg=#e0c38c]{stdout}"
                command_git_interval   "5"
                command_git_rendermode "static"

                // podpowiedzi skrótów dla aktualnego trybu (plugin zjstatus-hints)
                pipe_zjstatus_hints_format "#[fg=#a08c8a]{output} "

                datetime          "#[fg=#e7bdb7,bold]󰥔 {format}"
                datetime_format   "%a %d %b %H:%M"
                datetime_timezone "Europe/Warsaw"
            }
        }
        children
    }
}
