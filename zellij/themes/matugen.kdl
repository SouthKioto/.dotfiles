// Generowane przez matugen z ~/.config/zellij/themes/matugen.kdl.template — nie edytuj ręcznie
themes {
    matugen {
        text_unselected {
            base "#f1dedc"
            background "#1a1110"
            emphasis_0 "#e0c38c"
            emphasis_1 "#ffb4aa"
            emphasis_2 "#e7bdb7"
            emphasis_3 "#ffb4ab"
        }
        text_selected {
            base "#f1dedc"
