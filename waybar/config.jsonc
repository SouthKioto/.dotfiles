{
  "exclusive": true,
  "reload_style_on_change": true,
  "position": "top",
  "spacing": 0,
  "height": 0,
  "width": 0,
  "margin-top": 0,
  "margin-bottom": 0,
  "modules-left": [
    "clock",
    "custom/weather",
    "custom/separator",
    "tray",
    "custom/separator",
    "group/workspaces"
  ],
  "modules-center": [
    "custom/focus",
    "custom/recording",
    "custom/mpris"
  ],
  "modules-right": [
    "group/right"
  ],
  "group/right": {
    "orientation": "inherit",
    "modules": [
      "custom/updates",
      "custom/nightlight",
      "backlight",
      "bluetooth",
      "network",
      "pulseaudio",
      "custom/power",
      "battery",
      "memory",
      "cpu"
    ]
  },
  // workspace'y: numer + jedna ikona na aplikację, tooltip z listą okien
  // (dane z ~/.config/hypr/scripts/workspaces.py, który odpala niewidoczny custom/ws-daemon)
  "group/workspaces": {
    "orientation": "inherit",
    "modules": [
      "custom/ws-daemon",
      "custom/ws#1",
      "custom/ws#2",
      "custom/ws#3",
      "custom/ws#4",
      "custom/ws#5",
      "custom/ws#6",
      "custom/ws#7",
      "custom/ws#8",
      "custom/ws#9",
      "custom/ws#10"
    ]
  },
  "custom/ws-daemon": {
    "exec": "python3 -u ~/.config/hypr/scripts/workspaces.py",
    "restart-interval": 2,
    "tooltip": false
  },
  "custom/ws#1": {
    "exec": "cat \"$XDG_RUNTIME_DIR/waybar-workspaces/$WAYBAR_OUTPUT_NAME/1.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 14,
    "cursor": true,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'"
  },
  "custom/ws#2": {
    "exec": "cat \"$XDG_RUNTIME_DIR/waybar-workspaces/$WAYBAR_OUTPUT_NAME/2.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 14,
    "cursor": true,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'"
  },
  "custom/ws#3": {
    "exec": "cat \"$XDG_RUNTIME_DIR/waybar-workspaces/$WAYBAR_OUTPUT_NAME/3.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 14,
    "cursor": true,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'"
  },
  "custom/ws#4": {
    "exec": "cat \"$XDG_RUNTIME_DIR/waybar-workspaces/$WAYBAR_OUTPUT_NAME/4.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 14,
    "cursor": true,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'"
  },
  "custom/ws#5": {
    "exec": "cat \"$XDG_RUNTIME_DIR/waybar-workspaces/$WAYBAR_OUTPUT_NAME/5.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 14,
    "cursor": true,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'"
  },
  "custom/ws#6": {
    "exec": "cat \"$XDG_RUNTIME_DIR/waybar-workspaces/$WAYBAR_OUTPUT_NAME/6.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 14,
    "cursor": true,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 6 })'"
  },
  "custom/ws#7": {
    "exec": "cat \"$XDG_RUNTIME_DIR/waybar-workspaces/$WAYBAR_OUTPUT_NAME/7.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 14,
    "cursor": true,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 7 })'"
  },
  "custom/ws#8": {
    "exec": "cat \"$XDG_RUNTIME_DIR/waybar-workspaces/$WAYBAR_OUTPUT_NAME/8.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 14,
    "cursor": true,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 8 })'"
  },
  "custom/ws#9": {
    "exec": "cat \"$XDG_RUNTIME_DIR/waybar-workspaces/$WAYBAR_OUTPUT_NAME/9.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 14,
    "cursor": true,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 9 })'"
  },
  "custom/ws#10": {
    "exec": "cat \"$XDG_RUNTIME_DIR/waybar-workspaces/$WAYBAR_OUTPUT_NAME/10.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 14,
    "cursor": true,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 10 })'"
  },
  "custom/separator": {
    "format": "|",
    "tooltip": false
  },
  "cpu": {
    "interval": 5,
    "format": "<span size='10pt'></span> {icon} {usage}%",
    "on-click": "kitty -e btop",
    "format-icons": [
      "<span size='8pt'>━</span>",
      "<span size='8pt'>■</span>",
      "<span size='8pt' color='#ff79d2'>■■</span>",
      "<span size='8pt' color='#ff6fbe'>■■■</span>",
      "<span size='8pt' color='#ff66a9'>■■■■</span>",
      "<span size='8pt' color='#ff5f94'>■■■■■</span>",
      "<span size='8pt' color='#ff5b7e'>■■■■■■</span>",
      "<span size='8pt' color='#fe5968'>■■■■■■■</span>",
      "<span size='8pt' color='#f65a52'>■■■■■■■■</span>",
      "<span size='8pt' color='#ec5d3c'>■■■■■■■■■</span>",
      "<span size='8pt' color='#df6124'>■■■■■■■■■■</span>"
    ]
  },
  "memory": {
    "interval": 5,
    "format": "<span size='9pt'></span> {icon} {used:0.1f}G",
    "on-click": "kitty -e btop",
    "format-icons": [
      "<span size='8pt'>━</span>",
      "<span size='8pt'>■</span>",
      "<span size='8pt' color='#f7b69a'>■■</span>",
      "<span size='8pt' color='#ef9875'>■■■</span>",
      "<span size='8pt' color='#e77b50'>■■■■</span>",
      "<span size='8pt' color='#df6124'>■■■■■</span>",
      "<span size='8pt' color='#d35720'>■■■■■■</span>",
      "<span size='8pt' color='#c64e1c'>■■■■■■■</span>",
      "<span size='8pt' color='#aa4318'>■■■■■■■■</span>",
      "<span size='8pt' color='#8e3813'>■■■■■■■■■</span>",
      "<span size='8pt' color='#722d0f'>■■■■■■■■■■</span>"
    ]
  },
  "clock": {
    "format": "{:%H:%M - %a, %d}",
    "format-alt": "{:L%d %B W%V %Y}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "month": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    }
  },
  "network": {
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format": "{icon}",
    "format-wifi": "{icon} {signalStrength}%",
    "format-ethernet": "󰈀 {bandwidthDownBytes:=}",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 5,
    "spacing": 1,
    "on-click": "kitty -e impala"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-discharging": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "format-plugged": "",
    "format-icons": {
      "charging": [
        "󰢜 <span size='8pt' color='#df6124'>━</span>",
        "󰢜 <span size='8pt' color='#df6124'>■</span>",
        "󰂆 <span size='8pt' color='#dd7006'>■■</span>",
        "󰂇 <span size='8pt' color='#d88000'>■■■</span>",
        "󰂈 <span size='8pt' color='#d09000'>■■■■</span>",
        "󰢝 <span size='8pt' color='#c5a000'>■■■■■</span>",
        "󰂉 <span size='8pt' color='#b5af00'>■■■■■■</span>",
        "󰢞 <span size='8pt' color='#a2be00'>■■■■■■■</span>",
        "󰂊 <span size='8pt' color='#8acc00'>■■■■■■■■</span>",
        "󰂋 <span size='8pt' color='#68da00'>■■■■■■■■■</span>",
        "󰂅 <span size='8pt' color='#25e712'>■■■■■■■■■■</span>"
      ],
      "default": [
        "󰁺 <span size='8pt' color='#df6124'>━</span>",
        "󰁺 <span size='8pt' color='#df6124'>■</span>",
        "󰁻 <span size='8pt' color='#dd7006'>■■</span>",
        "󰁼 <span size='8pt' color='#d88000'>■■■</span>",
        "󰁽 <span size='8pt' color='#d09000'>■■■■</span>",
        "󰁾 <span size='8pt' color='#c5a000'>■■■■■</span>",
        "󰁿 <span size='8pt' color='#b5af00'>■■■■■■</span>",
        "󰂀 <span size='8pt' color='#a2be00'>■■■■■■■</span>",
        "󰂁 <span size='8pt' color='#8acc00'>■■■■■■■■</span>",
        "󰂂 <span size='8pt' color='#68da00'>■■■■■■■■■</span>",
        "󰁹 <span size='8pt' color='#25e712'>■■■■■■■■■■</span>"
      ]
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{timeTo}",
    "tooltip-format-charging": "{timeTo}",
    "interval": 30,
    "on-click": "~/.config/hypr/scripts/power-menu.sh",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "bluetooth": {
    "format": " {status} {num_connections}",
    "format-off": "󰂲 OFF",
    "format-disabled": "󰂲 {status}",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "kitty -e bluetui"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "on-click": "pavucontrol-qt",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": [
        "",
        "",
        ""
      ]
    }
  },
  "backlight": {
    "device": "intel_backlight",
    "rotate": 0,
    "format": "{icon} {percent}%",
    "tooltip-format": "🌕 {percent}%",
    "format-icons": [
      "󰃜",
      "󰃝",
      "󰃞",
      "󰃟",
      "󰃠"
    ]
  },
  "tray": {
    "icon-size": 12,
    "spacing": 5
  },
  "custom/power": {
    "exec": "~/.config/hypr/scripts/power-profile.sh status",
    "return-type": "json",
    "interval": "once",
    "signal": 9,
    "on-click": "~/.config/hypr/scripts/power-profile.sh cycle",
    "on-click-right": "~/.config/hypr/scripts/power-profile.sh menu"
  },
  "custom/nightlight": {
    "exec": "~/.config/hypr/scripts/nightlight.sh status",
    "return-type": "json",
    "interval": 300,
    "signal": 11,
    "on-click": "~/.config/hypr/scripts/nightlight.sh toggle"
  },
  "custom/weather": {
    "exec": "~/.config/hypr/scripts/weather.sh",
    "return-type": "json",
    "interval": 60,
    "on-click": "qs -c widgets ipc call widgets toggle"
  },
  "custom/updates": {
    "exec": "~/.config/hypr/scripts/updates.sh status",
    "return-type": "json",
    "interval": 3600,
    "signal": 13,
    "on-click": "~/.config/hypr/scripts/updates.sh run"
  },
  "custom/focus": {
    "exec": "~/.config/hypr/scripts/focus.sh status",
    "return-type": "json",
    "interval": 60,
    "signal": 12,
    "on-click": "~/.config/hypr/scripts/focus.sh toggle"
  },
  "custom/recording": {
    "exec": "~/.config/hypr/scripts/record.sh status",
    "return-type": "json",
    "interval": "once",
    "signal": 10,
    "on-click": "~/.config/hypr/scripts/record.sh stop"
  },
  "custom/mpris": {
    "exec": "python3 -u ~/.config/hypr/scripts/mpris.py",
    "format": "{text}",
    "return-type": "json",
    "on-click": "playerctl play-pause",
    "tooltip": false
  }
}
